# MQTT
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# InfluxDB
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=iot-pulse-dev-token
INFLUX_ORG=iot-pulse
INFLUX_BUCKET=sensor_data

# InfluxDB init (used by docker image on first run)
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=adminpassword
DOCKER_INFLUXDB_INIT_ORG=iot-pulse
DOCKER_INFLUXDB_INIT_BUCKET=sensor_data
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=iot-pulse-dev-token

# Frontend
VITE_API_BASE_URL=
